{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "whoami.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "..",
        "files": [
          "whoami.yml",
          "whoami.json",
          "register.py"
        ]
      }
    ],
    "globalMetadata": {
      "_enableNewTab": true,
      "_enableSearch": true,
      "_appLogoUrl": "https://harp-tech.org/",
      "_appFooter": "&copy; harp-tech and Contributors. Licensed under <a href=\"https://creativecommons.org/licenses/by-sa/4.0/\">CC BY-SA 4.0</a>. Made with <a href=\"https://dotnet.github.io/docfx\">docfx</a>",
      "_gitContribute": {
        "repo": "https://github.com/harp-tech/whoami",
        "branch": "main"
      },
      "_disableToc": false,
      "_navRel": "../toc.html",
      "_tocRel": "../build/toc.html"
    },
    "output": "../artifacts/docs/site/",
    "template": [
      "default",
      "modern",
      "harp-docfx/template",
      "template"
    ],
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "attributes",
        "customcontainers"
      ]
    },
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}

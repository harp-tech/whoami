{
    "$id": "https://harp-tech.org/whoami/whoami.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The registry of WhoAmI identifiers reserved for Harp devices",
    "$defs": {
        "app": {
            "description": "The dedicated app for this device",
            "discriminator": {
                "propertyName": "type",
                "mapping": {
                    "dotnetTool": "#/$defs/dotnetToolApp"
                }
            },
            "oneOf": [
                {
                    "$ref": "#/$defs/dotnetToolApp"
                }
            ]
        },
        "device": {
            "description": "A device registered under its WhoAmI identifier",
            "properties": {
                "authors": {
                    "description": "The authors of the device",
                    "type": "string"
                },
                "name": {
                    "description": "The name of the device",
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                },
                "projectUrl": {
                    "description": "The address of the home page of the device",
                    "type": "string"
                },
                "repositoryUrl": {
                    "description": "The address of the source repository of the device",
                    "type": "string"
                },
                "app": {
                    "$ref": "#/$defs/app"
                }
            },
            "required": ["name"],
            "type": "object"
        },
        "dotnetToolApp": {
            "description": "An app published as a .NET tool and resolved from nuget.org",
            "properties": {
                "type": {
                    "description": "The type of app",
                    "type": "string",
                    "const": "dotnetTool"
                },
                "package": {
                    "$ref": "#/$defs/packageIdentifier"
                }
            },
            "required": ["type", "package"],
            "additionalProperties": false,
            "type": "object"
        },
        "owner": {
            "description": "An owner shared by several devices, referred to from each device with a merge key",
            "properties": {
                "authors": {
                    "description": "The authors of the devices",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "packageIdentifier": {
            "description": "The identifier of the package that provides the app",
            "type": "string",
            "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
        }
    },
    "properties": {
        "devices": {
            "description": "A map of device WhoAmI to device information",
            "patternProperties": {
                "^[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]$": {
                    "$ref": "#/$defs/device"
                }
            },
            "type": "object"
        },
        "owners": {
            "description": "A map of owner key to shared device ownership information",
            "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                    "$ref": "#/$defs/owner"
                }
            },
            "type": "object"
        }
    }
}